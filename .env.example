# Copy to .env.local for local testing (node scripts/dev-server.js).
# On Vercel, add these under Project → Settings → Environment Variables.

# --- Database (required to save submissions, power the dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Team dashboard at /admin (at least 8 characters)
ADMIN_PASSWORD=choose-a-long-password

# --- Email alerts to your team (optional but recommended) — https://resend.com
RESEND_API_KEY=
# Who receives alerts (comma-separated). Defaults to hello@soloworks.in
NOTIFY_EMAIL=hello@soloworks.in
# Sender on a domain you verified in Resend. When set, submitters also get a confirmation email.
RESEND_FROM=SoloWorks <hello@your-domain.com>
# Set to false to stop confirmation emails to submitters
SEND_CONFIRMATIONS=true

# --- Slack alerts (optional) — an Incoming Webhook URL
SLACK_WEBHOOK_URL=

# --- Your live address, used for the dashboard link in alerts
SITE_URL=https://your-soloworks-site.vercel.app
